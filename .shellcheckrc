# Project-wide shellcheck defaults (used by CI and local lint).
# SC1091 — cannot follow dynamic $SCRIPT_DIR sources
# SC2155 — declare and assign (stylistic)
# SC2034 — STATUS_* / INTERNET_EXIT set in sourced handler libs, read by orchestrators
# NOTE: SC2086 removed from global disable — use inline overrides where intentional
disable=SC1091,SC2155,SC2034
